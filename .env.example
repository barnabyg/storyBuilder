# Copy this file to `.env` (gitignored) and fill in the values you need.
# Variables already set in the environment take precedence over `.env`.

# API key for the `deepseek` provider used by configs/smoke.yaml.
DEEPSEEK_API_KEY=

# Optional: point the `deepseek` provider at another OpenAI-compatible base URL.
# NDE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional: the same override for the `openai` and local providers.
# NDE_OPENAI_BASE_URL=https://api.openai.com/v1
# NDE_LOCAL_BASE_URL=http://localhost:11434/v1

# API key for the `openai` provider used by configs/benchmark-g0.yaml.
OPENAI_API_KEY=