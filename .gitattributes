# Normalise all text files to LF in the index and the working tree, overriding
# core.autocrlf on Windows checkouts.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.sqlite binary
*.sqlite3 binary
*.db binary
*.whl binary
*.gz binary

# These two immutable pilot documents were owner-approved with CRLF bytes.
# Preserve their exact SHA-256 approval seals; review if either is superseded.
# Recognise CRLF while retaining the normal trailing-space checks.
benchmark/prereg/dev-mb-pilot-20261027.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
benchmark/pilots/mb-20261027/frozen.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
