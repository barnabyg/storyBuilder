# Normalise all text files to LF in the index and the working tree, overriding
# core.autocrlf on Windows checkouts.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.sqlite binary
*.sqlite3 binary
*.db binary
*.whl binary
*.gz binary
