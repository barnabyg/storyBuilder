{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 -c \"import pathlib,runpy,subprocess,sys; p=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())/'tools'/'hygiene.py'; sys.argv=[str(p),'hook']; runpy.run_path(str(p),run_name='__main__')\"",
            "commandWindows": "python -c \"import pathlib,runpy,subprocess,sys; p=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())/'tools'/'hygiene.py'; sys.argv=[str(p),'hook']; runpy.run_path(str(p),run_name='__main__')\"",
            "statusMessage": "Checking project hygiene cycle",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume)$"
      }
    ]
  }
}
